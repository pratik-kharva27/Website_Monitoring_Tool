# Copy this file to .env and fill in real values. Do NOT commit .env.

# Server
NODE_ENV=production
PORT=5000

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=https://your-frontend-domain.example.com

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=website_monitor
DB_POOL_LIMIT=10
